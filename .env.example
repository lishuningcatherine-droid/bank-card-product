# Copy to .env and fill in. Never commit .env.
BANKREC_ENV=dev                          # dev | test | prod (prod refuses test_only data and disables API docs)
DATABASE_URL=postgresql+psycopg://bankrec:bankrec@localhost:5432/bankrec
API_DATABASE_URL=postgresql+psycopg://bankrec_api:bankrec_api@localhost:5432/bankrec   # read-only role over prod
POSTGRES_PASSWORD=change-me
API_DB_PASSWORD=change-me
BANKREC_CONTACT_EMAIL=contact@example.invalid   # placeholder; set your real address locally (sent in the User-Agent)
BANKREC_PROJECT_URL=https://github.com/lishuningcatherine-droid/bank-card-product
WEB_ORIGIN=http://localhost:3000         # CORS: the only origin allowed to call the API
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000   # baked into the web build
API_INTERNAL_URL=http://localhost:8000   # server-side API URL used by the web app
REVALIDATE_URL=http://localhost:3000/api/internal/revalidate
REVALIDATE_SECRET=                       # >= 32 random characters, same value for web and worker
ALERT_WEBHOOK_URL=                       # optional parser-regression webhook (off when empty)
ALERT_WEBHOOK_SECRET=
BANKREC_SCHEDULER=off                    # worker | github | off — exactly one scheduler should be active
CAPTURE_RUNNER_LABEL=local               # recorded in capture conditions (e.g. worker, github-actions)
BANKREC_CHROMIUM_EXECUTABLE=             # optional path to Chromium for Playwright
BANKREC_MIN_HOST_INTERVAL_S=3            # never lower than 3 in production
BANKREC_REVIEWER=                        # name recorded with review decisions
API_POST_RATE_LIMIT_PER_MINUTE=30
SENTRY_DSN=                              # optional error tracking, disabled when empty
E2E_TEST_DATA=0                          # E2E only: serve fictional Example Bank data (refused in prod)
NEXT_PUBLIC_TEST_DATA_BANNER=            # "1" shows the test-data banner (E2E/screenshots only)
